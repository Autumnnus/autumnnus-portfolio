# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=autumnnus_portfolio
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/autumnnus_portfolio?schema=public"

# MinIO (Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=autumnnus-assets
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Next.js Settings
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_EMAIL="admin@example.com"

# Auth.js (Authentication)
# Generate a secret via: openssl rand -base64 32
AUTH_SECRET="your_auth_secret_here"
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"
AUTH_URL="http://localhost:3001/api/auth"

# AI Assistant (Vercel AI SDK 7)
# LLM + embeddings: Google Gemini API key (https://aistudio.google.com/apikey)
# One or more Gemini keys (comma separated). When a key hits its quota the
# assistant switches to the next one automatically.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Chat models are chosen in Admin > AI Assistant (with prices).
# Jev (TypeSafe AI "System One" decision model) — optional precision/control
# layer. Either a direct TypeSafe key or a Vercel AI Gateway key enables it.
TYPESAFE_AI_API_KEY=""
AI_GATEWAY_API_KEY=""
# Evaluator used when Jev is not configured: "gemini" | "off"
AI_EVALUATOR_FALLBACK="gemini"
# Reverse proxies in front of the app (Coolify/Traefik = 1). Used to read the
# real client IP from X-Forwarded-For for rate limiting.
TRUSTED_PROXY_HOPS=1

# Cloudflare Turnstile (Captcha)
TURNSTILE_SECRET_KEY="your_turnstile_secret_key"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your_turnstile_site_key"

# Telegram Bot (For Notifications)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# Umami Analytics (Production)
NEXT_PUBLIC_UMAMI_URL=http://localhost:3030
NEXT_PUBLIC_UMAMI_ID="your-umami-id"

NIXPACKS_NODE_VERSION=22.13.0

# GitHub sends an `iss` param on OAuth callback (RFC 9207); must match
AUTH_GITHUB_ISSUER="https://github.com/login/oauth"
